# Point at a reachable FalkorDB (required on Vercel — localhost will not work)
# Option A — FalkorDB Cloud: https://docs.falkordb.com/cloud/quickstart
#   Copy host:port from Connectivity; user/password from Instance Details
# Option B — Docker on any VPS: docker run -p 6379:6379 falkordb/falkordb:latest
FALKOR_HOST=localhost
FALKOR_PORT=6379
# FALKOR_USERNAME=falkordb
# FALKOR_PASSWORD=your-cloud-or-redis-password
# FALKOR_SSL=false   # true on paid Cloud tiers with TLS; Free tier = false

SALUS_TENANT=acme
SALUS_ENV=development

# API auth (required in production — do not use the default)
SALUS_API_KEY=salus-dev-change-me
# SALUS_ADMIN_KEY=even-stronger-admin-key
# SALUS_AUTH_DISABLED=false

# Comma-separated browser origins allowed for CORS
SALUS_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# On Vercel, also include your deployment URL, e.g.:
# SALUS_CORS_ORIGINS=https://your-app.vercel.app

# Production host allowlist (Trusted Host). Defaults include *.vercel.app
# SALUS_ALLOWED_HOSTS=your-app.vercel.app,*.vercel.app,localhost

# Optional extra tenants the API may switch to
# SALUS_ALLOWED_TENANTS=

SALUS_MAX_QUESTION_CHARS=2000
# SALUS_TRUST_XFF=false
# SALUS_HSTS=false
# SALUS_DEBUG=false

# Optional: LLM tool selection (or paste in the UI OpenAI key field)
# OPENAI_API_KEY=sk-...
# SALUS_LLM_MODEL=gpt-4o-mini
